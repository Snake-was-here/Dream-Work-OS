      "formula": "=IF($A2=\"\",\"\",LET(t,MAXIFS(MESSAGES!$C$2:$C$1000,MESSAGES!$B$2:$B$1000,$A2,MESSAGES!$D$2:$D$1000,\"INBOUND\",MESSAGES!$K$2:$K$1000,\"RECEIVED\",MESSAGES!$N$2:$N$1000,\"\"),IF(t=0,\"\",t)))"
    },
    {
      "sheet": "OPPORTUNITIES",
      "columnIndex": 33,
      "formula": "=IF($A2=\"\",\"\",LET(t,MINIFS(MESSAGES!$C$2:$C$1000,MESSAGES!$B$2:$B$1000,$A2,MESSAGES!$D$2:$D$1000,\"INBOUND\",MESSAGES!$K$2:$K$1000,\"RECEIVED\",MESSAGES!$M$2:$M$1000,\"POSITIVE\",MESSAGES!$N$2:$N$1000,\"\",MESSAGES!$C$2:$C$1000,\">0\"),IF(t=0,\"\",t)))"
    },
    {
      "sheet": "OPPORTUNITIES",
      "columnIndex": 37,
      "formula": "=IF($B2=\"\",\"\",IF($A2=\"\",\"NEEDS OPPORTUNITY ID\",IF(COUNTIF($A$2:$A$1000,$A2)>1,\"DUPLICATE OPPORTUNITY ID\",IF(OR(AND($AD2<>\"\",COUNTIF($AD$2:$AD$1000,$AD2)>1),COUNTIFS($B$2:$B$1000,$B2,$C$2:$C$1000,$C2)>1),\"POSSIBLE DUPLICATE\",\"\"))))"
