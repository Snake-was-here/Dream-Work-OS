      "formula": "=IF($A2=\"\",\"\",IF(OR(AND($D2=\"OUTBOUND\",$K2=\"SENT\"),AND($D2=\"INBOUND\",$K2=\"RECEIVED\")),IF(OR(C2=\"\",C2=0),NOW(),C2),IF(OR(C2=\"\",C2=0),\"\",C2)))"
